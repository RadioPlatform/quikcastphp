{
    "name": "quikcast/quikcast",
    "description": "PHP client library for the Quikcast native management API.",
    "type": "library",
    "license": "MIT",
    "keywords": ["quikcast", "streaming", "icecast", "management-api", "elliephp"],
    "require": {
        "php": "^8.4",
        "elliephp/httpclient": "^1.0",
        "symfony/http-client-contracts": "^3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.0",
        "symfony/http-client": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Quikcast\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Quikcast\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "lint": "pint --test",
        "lint:fix": "pint",
        "stan": "phpstan analyse --no-progress",
        "validate": "composer validate --strict"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "minimum-stability": "stable"
}
